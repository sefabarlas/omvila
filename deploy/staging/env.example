# Test ortamı ortam değişkenleri. Kopyalayın: cp deploy/staging/env.example deploy/staging/.env
# Gerçek değerler depoya girmez (.gitignore: .env, .env.*). Boş bırakılan zorunlu değerde compose açılmaz.
# Değerde `$` varsa tek tırnak kullanın (compose tek tırnak içini yorumlamaz); bcrypt özeti için gerekli.

# --- İmaj etiketi ---------------------------------------------------------------------------------
# ghcr.io/sefabarlas/omvila-<servis>:<TAG>. Boşsa latest.
TAG=

# --- Veritabanı -----------------------------------------------------------------------------------
# omvila_migrator: postgres süper kullanıcısı ve tablo sahibi (yalnız migrate rolü kullanır).
# omvila_app: uygulama rolü (RLS'e tabi). Parola yalnız ilk açılışta (boş birim) uygulanır; sonradan
# değiştirmek için: docker compose ... exec postgres psql -U omvila_migrator -d omvila -c "ALTER ROLE omvila_app PASSWORD '...'"
# Üretim: openssl rand -base64 32 | tr -d '/+='
OMVILA_MIGRATOR_DB_PASSWORD=
OMVILA_APP_DB_PASSWORD=

# --- Kimlik ve OTP --------------------------------------------------------------------------------
# JWT imza anahtarı: ES256 (P-256) özel anahtar, PEM. Üretim:
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# Çok satırlı değer çift tırnak içinde, satır sonları \n ile yazılır:
#   AUTH_SIGNING_KEY_PEM="-----BEGIN PRIVATE KEY-----\nMIG...\n-----END PRIVATE KEY-----"
AUTH_SIGNING_KEY_ID=
AUTH_SIGNING_KEY_PEM=
# OTP kod özeti HMAC anahtarı: en az 32 bayt, base64. Üretim: openssl rand -base64 32
AUTH_OTP_HMAC_KEY=

# --- Kapora IBAN'ı (T-78) -------------------------------------------------------------------------
# IBAN'ı veritabanında şifreleyen AES-256-GCM anahtarı: tam 32 bayt, base64. Üretim: openssl rand -base64 32
# Değiştirilirse kayıtlı IBAN'lar okunamaz (salon IBAN'ı yeniden girer); yedeği parola yöneticisinde tutun.
TENANCY_IBAN_KEY=

# --- SMS (sahte sağlayıcı, T-03) ------------------------------------------------------------------
# Teslim raporu ucunun (POST /api/v1/webhooks/sms/fake) imza gizlisi. Üretim: openssl rand -hex 32
SMS_FAKE_WEBHOOK_SECRET=
# SMS günlüğü sayfasının API'deki yolu (sms adresinin kökü buraya yönlenir; API adresinde kapalı).
SMS_LOG_PATH=/dev/sms

# --- Basic auth (salon, randevu, www, sms, posta) ------------------------------------------------------
# Özet üretimi: docker run --rm caddy:2 caddy hash-password --plaintext '<parola>'
# Özet `$` içerir: tek tırnakla yazın, ör. BASIC_AUTH_HASH='$2a$14$...'
BASIC_AUTH_USER=
BASIC_AUTH_HASH=

# --- Adresler (varsayılan: test ortamı; yalnız yerel denemede değiştirilir) -------------------------
# URL'ler derleme argümanıdır da (VITE_API_URL, NEXT_PUBLIC_*): değişince web imajları yeniden derlenir.
# API_URL=https://api.test.omvila.com.tr
# SALON_URL=https://salon.test.omvila.com.tr
# RANDEVU_URL=https://randevu.test.omvila.com.tr
# WWW_URL=https://www.test.omvila.com.tr
# ADMIN_URL=https://admin.test.omvila.com.tr
# SALON_HOST=salon.test.omvila.com.tr
# API_HOST=api.test.omvila.com.tr
# RANDEVU_HOST=randevu.test.omvila.com.tr
# WWW_HOST=www.test.omvila.com.tr
# SMS_HOST=sms.test.omvila.com.tr
# POSTA_HOST=posta.test.omvila.com.tr

# --- Rezervasyon sayfası (isteğe bağlı) -----------------------------------------------------------
# Aydınlatma metni bağlantısı ve sürümü; boşsa uygulama varsayılanı.
PRIVACY_NOTICE_URL=
PRIVACY_NOTICE_VERSION=
# Uygulama derin bağlantıları (com.omvila.app): Apple Team ID ve Android imza SHA-256 parmak izleri (virgülle).
# Boşsa /.well-known/apple-app-site-association ve assetlinks.json 404 döner (T-100).
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=

# --- Tanıtım sitesi ------------------------------------------------------------------------------
# "Giriş yap" ve "Ücretsiz dene" bağlantıları SALON_URL'in /giris ve /kayit adreslerine gider (derlemede gömülür).
# true: arama motorlarına kapalı (robots.txt + meta robots). Boşsa true; canlıda false.
SITE_NOINDEX=true

# --- Yerel deneme (compose.local.yml ile) ---------------------------------------------------------
# Zorunlu değerlere ek olarak (deploy/staging/.env.local):
# API_URL=https://api.localhost:8443
# SALON_URL=https://salon.localhost:8443
# RANDEVU_URL=https://randevu.localhost:8443
# WWW_URL=https://www.localhost:8443
# ADMIN_URL=https://admin.localhost:8443
# SALON_HOST=salon.localhost
# API_HOST=api.localhost
# RANDEVU_HOST=randevu.localhost
# WWW_HOST=www.localhost
# SMS_HOST=sms.localhost
# POSTA_HOST=posta.localhost

# compose ağının alt ağı; API yalnız buradan gelen X-Forwarded-* başlıklarına güvenir. Sunucuda çakışırsa değiştirin.
# STAGING_SUBNET=172.30.0.0/24
