# Test ortamının kenar sunucusu: otomatik HTTPS (Let's Encrypt), alan adına göre yönlendirme.
# Alan adları ve portlar ortamdan gelir (varsayılanlar test ortamı); yerel deneme: deploy/staging/compose.local.yml.
# Basic auth yalnız geliştirici araçlarında (sms: giriş kodları, posta: Mailpit). Ürün yüzeyleri (salon, admin, randevu,
# www) ürün sahibinin kararıyla açık; kendi girişleri (telefon + SMS kodu) korur, arama motorlarına noindex ile kapalı.
{
	http_port {$CADDY_HTTP_PORT:80}
	https_port {$CADDY_HTTPS_PORT:443}
}

(common) {
	# Test ortamı arama motorlarına kapalı.
	header X-Robots-Tag "noindex, nofollow"
	encode zstd gzip
}

(protected) {
	# Kullanıcı ve bcrypt özeti .env'den (BASIC_AUTH_USER, BASIC_AUTH_HASH; üretim: caddy hash-password).
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}
}

{$SALON_HOST:salon.test.omvila.com.tr} {
	import common
	reverse_proxy salon-panel:8080
}

# Platform paneli (iç ekip; T-123): platform kullanıcısının telefonu + SMS kodu.
{$ADMIN_HOST:admin.test.omvila.com.tr} {
	import common
	reverse_proxy platform-panel:8080
}

{$API_HOST:api.test.omvila.com.tr} {
	import common
	# SMS günlüğü yalnız kendi korumalı adresinden açılır; herkese açık API adresinden erişilmez (OTP kodları içerir).
	@smslog path {$SMS_LOG_PATH:/dev/sms} {$SMS_LOG_PATH:/dev/sms}/*
	respond @smslog 404
	reverse_proxy api:8080
}

{$RANDEVU_HOST:randevu.test.omvila.com.tr} {
	import common
	reverse_proxy rezervasyon:3000
}

# Tanıtım sitesi (statik). Test ortamında noindex.
{$WWW_HOST:www.test.omvila.com.tr} {
	import common
	reverse_proxy tanitim:8080
}

# SMS günlüğü sayfası API kapsayıcısında sunulur (sahte sağlayıcının infra.dev_sms_log kayıtları).
# SMS_LOG_PATH: API'deki yol (/dev/sms; Sms:DevLog ayarları, T-76).
{$SMS_HOST:sms.test.omvila.com.tr} {
	import common
	import protected
	@root path /
	rewrite @root {$SMS_LOG_PATH:/dev/sms}
	reverse_proxy api:8080
}

{$POSTA_HOST:posta.test.omvila.com.tr} {
	import common
	import protected
	reverse_proxy mailpit:8025
}
