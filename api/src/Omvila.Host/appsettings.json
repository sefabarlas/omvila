{
  "Auth": {
    "Issuer": "omvila",
    "AccessTokenMinutes": 15
  },
  "Outbox": {
    "BatchSize": 50,
    "DispatchIntervalSeconds": 1,
    "RetryBaseDelaySeconds": 30,
    "RetryMaxDelaySeconds": 3600
  },
  "Idempotency": {
    "RetentionHours": 24,
    "PurgeIntervalMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
