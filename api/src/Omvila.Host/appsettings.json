{
  "Auth": {
    "Issuer": "omvila",
    "AccessTokenMinutes": 15,
    "RefreshTokenDaysRemembered": 30,
    "RefreshTokenDaysSession": 1,
    "Otp": {
      "Length": 6,
      "TtlSeconds": 180,
      "ResendCooldownSeconds": 60,
      "MaxAttempts": 5,
      "LockoutMinutes": 5,
      "MaxPerPhonePerHour": 5
    }
  },
  "Outbox": {
    "BatchSize": 50,
    "DispatchIntervalSeconds": 1,
    "RetryBaseDelaySeconds": 30,
    "RetryMaxDelaySeconds": 3600
  },
  "Idempotency": {
    "RetentionHours": 24,
    "PurgeIntervalMinutes": 60
  },
  "Notifications": {
    "DispatchIntervalSeconds": 1,
    "BatchSize": 50,
    "MaxAttempts": 3,
    "RetryDelaySeconds": 60
  },
  "Sms": {
    "DefaultSender": "OMVILA"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
