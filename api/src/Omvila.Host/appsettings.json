{
  "Auth": {
    "Issuer": "omvila",
    "AccessTokenMinutes": 15,
    "RefreshTokenDaysRemembered": 30,
    "RefreshTokenDaysSession": 1,
    "Otp": {
      "Length": 6,
      "TtlSeconds": 180,
      "ResendCooldownSeconds": 60,
      "MaxAttempts": 5,
      "LockoutMinutes": 5,
      "MaxPerPhonePerHour": 5,
      "MaxPerIpPerHour": 20
    },
    "SignupTokenMinutes": 15,
    "PublicBookingTokenMinutes": 30,
    "TrustedDeviceDays": 30,
    "PanelSignInUrl": "https://omvila.com/giris"
  },
  "Legal": {
    "TermsOfUseVersion": "2026-11-01",
    "PrivacyNoticeVersion": "2026-11-01"
  },
  "Tenancy": {
    "BookingPageBaseUrl": "https://omvila.com/"
  },
  "Customers": {
    "Import": {
      "MaxFileBytes": 2097152,
      "MaxRows": 5000,
      "PreviewTtlMinutes": 60
    },
    "DataExport": {
      "ProcessIntervalSeconds": 60,
      "ApplyRetentionIntervalMinutes": 1440
    }
  },
  "Integrations": {
    "Calendar": {
      "Provider": "",
      "StateMinutes": 10,
      "SyncWindowDays": 60,
      "SyncIntervalSeconds": 300,
      "RefreshAheadMinutes": 10
    }
  },
  "Platform": {
    "TrialDays": 14,
    "PastDueGraceDays": 7,
    "TrialPlanCode": "salon_plus"
  },
  "Outbox": {
    "BatchSize": 50,
    "DispatchIntervalSeconds": 1,
    "RetryBaseDelaySeconds": 30,
    "RetryMaxDelaySeconds": 3600
  },
  "Idempotency": {
    "RetentionHours": 24,
    "PurgeIntervalMinutes": 60
  },
  "Notifications": {
    "DispatchIntervalSeconds": 1,
    "BatchSize": 50,
    "MaxAttempts": 5,
    "RetryBaseDelaySeconds": 30,
    "RetryMaxDelaySeconds": 3600
  },
  "Sales": {
    "ExpireCustomerPackagesIntervalMinutes": 60
  },
  "Scheduling": {
    "ExpireAppointmentHoldsIntervalSeconds": 60,
    "MarkNoShowsIntervalSeconds": 60,
    "ExtendRecurringSeriesIntervalMinutes": 60,
    "ExpireWaitlistOffersIntervalSeconds": 60,
    "ExpireWaitlistEntriesIntervalMinutes": 60,
    "SendDailySummariesIntervalSeconds": 300
  },
  "Sms": {
    "DefaultSender": "OMVILA",
    "DevLog": {
      "Limit": 100,
      "RefreshSeconds": 10
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Cors": {
    "PreflightMaxAgeSeconds": 600,
    "Surfaces": {
      "Manage": { "Origins": [] },
      "Admin": { "Origins": [] },
      "Me": { "Origins": [] },
      "Public": { "Origins": [] }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
