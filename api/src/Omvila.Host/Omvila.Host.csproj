<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Omvila.Host</RootNamespace>
    <!-- OpenAPI belgesi yalnız istenince üretilir: api/scripts/export-openapi.sh -->
    <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)../../artifacts</OpenApiDocumentsDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NodaTime" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Omvila.SharedKernel\Omvila.SharedKernel.csproj" />
    <ProjectReference Include="..\Omvila.Infrastructure\Omvila.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Identity\Omvila.Modules.Identity\Omvila.Modules.Identity.csproj" />
    <ProjectReference Include="..\Modules\Notifications\Omvila.Modules.Notifications\Omvila.Modules.Notifications.csproj" />
    <ProjectReference Include="..\Modules\Tenancy\Omvila.Modules.Tenancy\Omvila.Modules.Tenancy.csproj" />
    <ProjectReference Include="..\Modules\Platform\Omvila.Modules.Platform\Omvila.Modules.Platform.csproj" />
    <ProjectReference Include="..\Modules\Catalog\Omvila.Modules.Catalog\Omvila.Modules.Catalog.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Omvila.Host.Tests" />
  </ItemGroup>
</Project>
